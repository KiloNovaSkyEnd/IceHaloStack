<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IceHaloStack_WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:IceHaloStack_WinUI.Controls"
    xmlns:local="using:IceHaloStack_WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Unloaded="MainPage_Unloaded"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Padding="32" RowSpacing="18" MaxWidth="1120" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Text="IceHaloStack" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="v0.9.6.8 · WinUI 3 + Python 规范引擎"
                               Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="完整经典工作区"
                            IsEnabled="{x:Bind ViewModel.CanNavigate, Mode=OneWay}"
                            Click="OpenClassicWorkspace_Click" />
                    <Button Content="图像堆栈"
                            IsEnabled="{x:Bind ViewModel.CanNavigate, Mode=OneWay}"
                            Click="OpenStackPage_Click" />
                    <Button Content="堆栈延时"
                            IsEnabled="{x:Bind ViewModel.CanNavigate, Mode=OneWay}"
                            Click="OpenTimelapsePage_Click" />
                </StackPanel>
            </Grid>

            <InfoBar Grid.Row="1"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     IsClosable="False"
                     Severity="Error"
                     Message="{x:Bind ViewModel.Error, Mode=OneWay}" />

            <Grid Grid.Row="2" ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="24"
                        CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Text="单张图像处理" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="先验证 WinUI、IPC、进度与取消的完整处理闭环。"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Header="输入图像"
                                     PlaceholderText="选择 TIFF、PNG 或 JPEG 文件"
                                     Text="{x:Bind ViewModel.InputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1"
                                    Content="浏览…"
                                    VerticalAlignment="Bottom"
                                    Click="PickInput_Click" />
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Header="输出 PNG"
                                     PlaceholderText="选择处理结果保存位置"
                                     Text="{x:Bind ViewModel.OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1"
                                    Content="另存为…"
                                    VerticalAlignment="Bottom"
                                    Click="PickOutput_Click" />
                        </Grid>

                        <Expander x:Name="ProcessingExpander" Header="完整处理方案" IsExpanded="False">
                            <ScrollViewer x:Name="DeferredProcessingPanel"
                                          x:Load="{x:Bind ProcessingExpander.IsExpanded, Mode=OneWay}"
                                          MaxHeight="620">
                                <controls:ProcessingSettingsControl ViewModel="{x:Bind ViewModel.Processing, Mode=OneWay}" />
                            </ScrollViewer>
                        </Expander>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="开始处理"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.StartProcessingCommand}" />
                            <Button Content="取消"
                                    IsEnabled="{x:Bind ViewModel.CanCancel, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.CancelCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Padding="24"
                        CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="14">
                        <TextBlock Text="任务状态" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="阶段" Opacity="0.7" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.Phase, Mode=OneWay}"
                                       TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="进度" Opacity="0.7" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
