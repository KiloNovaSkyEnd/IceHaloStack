<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IceHaloStack_WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IceHaloStack_WinUI.Controls"
    NavigationCacheMode="Required"
    Loaded="MainPage_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:ClassicCommandStrip
            AddImagesRequested="PickInputs_Click"
            AddFolderRequested="PickFolder_Click"
            RemoveSelectedRequested="RemoveSelected_Click"
            StartRequested="StartStack_Click"
            CancelRequested="Cancel_Click"
            PauseRequested="Pause_Click"
            UseCurrentRequested="UseCurrent_Click"
            UndoRequested="Undo_Click"
            RedoRequested="Redo_Click"
            AutoStretchRequested="AutoStretch_Click"
            OpenTimelapseRequested="OpenTimelapse_Click"
            ChooseOutputRequested="PickOutputDirectory_Click"
            OpenImageRequested="OpenImage_Click"
            SavePreviewRequested="SavePreview_Click"
            ClearProjectRequested="ClearProject_Click"
            ExitRequested="Exit_Click"
            SelectAllRequested="SelectAll_Click"
            ResetProcessingRequested="ResetProcessing_Click"
            ProcessingSectionRequested="ProcessingSection_Requested"
            FitPreviewRequested="FitPreview_Click"
            ThemeRequested="Theme_Requested"
            FontRequested="Font_Requested"
            LanguageRequested="Language_Requested"
            HelpRequested="Help_Requested" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="190" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="520" MinWidth="380" />
            </Grid.ColumnDefinitions>
            <controls:ClassicFramesPane ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
            <Border Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <controls:ClassicPreviewPane x:Name="PreviewPane" Grid.Column="2" ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
            <Border Grid.Column="3" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <controls:ClassicProcessingTabs x:Name="ProcessingTabs" Grid.Column="4" ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="2" Padding="8,5" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
            <ProgressBar Grid.Column="1" Minimum="0" Maximum="100"
                         Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" />
            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Phase, Mode=OneWay}" />
        </Grid>

        <InfoBar Grid.Row="1" Margin="12" VerticalAlignment="Top" HorizontalAlignment="Center"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False"
                 Severity="Error" Message="{x:Bind ViewModel.Error, Mode=OneWay}" />
    </Grid>
</Page>
