<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="IceHaloStack_WinUI.Controls.ClassicChannelPanel" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:IceHaloStack_WinUI.Controls">
    <StackPanel Padding="8" Spacing="8">
        <ToggleSwitch Header="启用通道混合器" IsOn="{Binding ViewModel.EnableChannelMixer, ElementName=Root, Mode=TwoWay}" />
        <ComboBox Header="输出通道" ItemsSource="{Binding ViewModel.ChannelOutputs, ElementName=Root}"
                  SelectedItem="{Binding ViewModel.ChannelOutput, ElementName=Root, Mode=TwoWay}" />
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ToggleSwitch Header="单色" IsOn="{Binding ViewModel.ChannelMonochrome, ElementName=Root, Mode=TwoWay}" />
            <ToggleSwitch Grid.Column="1" Header="色彩噪声保护" IsOn="{Binding ViewModel.ChannelNoiseProtection, ElementName=Root, Mode=TwoWay}" />
        </Grid>
        <controls:ParameterSectionControl Section="{Binding ViewModel.ChannelSection, ElementName=Root}" />
    </StackPanel>
</UserControl>
