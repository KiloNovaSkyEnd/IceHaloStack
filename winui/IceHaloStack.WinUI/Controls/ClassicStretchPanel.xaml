<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="IceHaloStack_WinUI.Controls.ClassicStretchPanel" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:IceHaloStack_WinUI.Controls">
    <StackPanel Padding="8" Spacing="8">
        <ToggleSwitch Header="启用拉伸" IsOn="{Binding ViewModel.EnableStretch, ElementName=Root, Mode=TwoWay}" />
        <controls:ParameterSectionControl Section="{Binding ViewModel.StretchSection, ElementName=Root}" />
    </StackPanel>
</UserControl>
