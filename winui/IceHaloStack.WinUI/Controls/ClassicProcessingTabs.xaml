<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="IceHaloStack_WinUI.Controls.ClassicProcessingTabs"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IceHaloStack_WinUI.Controls">
    <Grid Padding="6" RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="处理参数 / Processing" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <TabView x:Name="ProcessingTabView" Grid.Row="1" IsAddTabButtonVisible="False" TabWidthMode="SizeToContent">
            <TabViewItem Header="堆栈">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="8" Spacing="9" DataContext="{Binding ViewModel, ElementName=Root}">
                        <ComboBox Header="堆栈方式" SelectedValuePath="Tag" SelectedValue="{Binding StackMethod, Mode=TwoWay}">
                            <ComboBoxItem Content="平均值 Mean" Tag="mean" />
                            <ComboBoxItem Content="最大值 Maximum" Tag="maximum" />
                        </ComboBox>
                        <ComboBox Header="分组方式" ItemsSource="{Binding GroupingModes}"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                  SelectedValue="{Binding GroupingMode, Mode=TwoWay}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox x:Name="WindowSizeBox" Header="窗口大小" Minimum="1"
                                       SpinButtonPlacementMode="Compact" ValueChanged="WindowSize_ValueChanged" />
                            <NumberBox x:Name="StepBox" Grid.Column="1" Header="步长" Minimum="1"
                                       SpinButtonPlacementMode="Compact" ValueChanged="Step_ValueChanged" />
                        </Grid>
                        <Button Content="生成堆栈分组" Click="GenerateGroups_Click" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="已生成" Opacity="0.7" />
                            <TextBlock Text="{Binding GroupCount}" Opacity="0.7" />
                            <TextBlock Text="组" Opacity="0.7" />
                        </StackPanel>
                        <TextBox Header="输出命名" Text="{Binding OutputFileNamePattern, Mode=TwoWay}" />
                        <TextBlock Text="{Binding OutputDirectory}" TextWrapping="Wrap" Opacity="0.65" />
                        <Button Content="应用命名到所有分组" Click="ApplyNaming_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="拉伸">
                <controls:ClassicStretchPanel ViewModel="{Binding ViewModel.Processing, ElementName=Root}" />
            </TabViewItem>
            <TabViewItem Header="基本明暗">
                <controls:ClassicBasePanel ViewModel="{Binding ViewModel.Processing, ElementName=Root}" />
            </TabViewItem>
            <TabViewItem Header="细节">
                <controls:ClassicDetailPanel ViewModel="{Binding ViewModel.Processing, ElementName=Root}" />
            </TabViewItem>
            <TabViewItem Header="通道">
                <controls:ClassicChannelPanel ViewModel="{Binding ViewModel.Processing, ElementName=Root}" />
            </TabViewItem>
            <TabViewItem Header="曲线">
                <controls:ClassicCurvesPanel ViewModel="{Binding ViewModel.Processing, ElementName=Root}" />
            </TabViewItem>
        </TabView>
    </Grid>
</UserControl>
