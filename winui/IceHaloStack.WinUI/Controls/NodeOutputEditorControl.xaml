<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="IceHaloStack_WinUI.Controls.NodeOutputEditorControl" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="8" MinWidth="430">
        <ToggleSwitch Header="保存图像序列" IsOn="{Binding ViewModel.SaveSequence, ElementName=Root, Mode=TwoWay}" />
        <ToggleSwitch Header="保存视频" IsOn="{Binding ViewModel.SaveVideo, ElementName=Root, Mode=TwoWay}" />
        <ComboBox Header="视频格式" ItemsSource="{Binding ViewModel.VideoFormats, ElementName=Root}"
                  SelectedItem="{Binding ViewModel.VideoFormat, ElementName=Root, Mode=TwoWay}" />
        <NumberBox Header="帧率 FPS" Minimum="0.1" Maximum="240" SmallChange="1"
                   Value="{Binding ViewModel.FramesPerSecond, ElementName=Root, Mode=TwoWay}" />
        <TextBox Header="流程/素材名称" Text="{Binding ViewModel.Name, ElementName=Root, Mode=TwoWay}" />
    </StackPanel>
</UserControl>
