<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="IceHaloStack_WinUI.Controls.ClassicCurvesPanel" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:IceHaloStack_WinUI.Controls">
    <StackPanel Padding="8" Spacing="8">
        <ToggleSwitch Header="启用曲线" IsOn="{Binding ViewModel.EnableCurves, ElementName=Root, Mode=TwoWay}" />
        <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Content="RGB" Tag="RGB" Click="Channel_Click" />
            <Button Content="红" Tag="红色" Click="Channel_Click" />
            <Button Content="绿" Tag="绿色" Click="Channel_Click" />
            <Button Content="蓝" Tag="蓝色" Click="Channel_Click" />
            <Button Content="亮度" Tag="亮度" Click="Channel_Click" />
        </StackPanel>
        <Grid Height="260">
            <controls:CurveEditorControl x:Name="CurveSurface"
                ViewModel="{Binding ViewModel.CurveEditor, ElementName=Root}" />
        </Grid>
        <TextBlock Text="左键添加或拖动控制点；右键删除非端点。端点只能上下移动。"
                   FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
        <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Content="重置当前通道" Click="ResetCurve_Click" />
            <Button Grid.Column="1" Content="全部通道重置" Click="ResetAll_Click" />
        </Grid>
    </StackPanel>
</UserControl>
