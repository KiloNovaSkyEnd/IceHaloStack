<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="IceHaloStack_WinUI.Controls.ClassicBasePanel" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:IceHaloStack_WinUI.Controls" xmlns:viewModels="using:IceHaloStack_WinUI.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="8" Spacing="7">
            <ToggleSwitch Header="启用基本调色" IsOn="{Binding ViewModel.EnableBasic, ElementName=Root, Mode=TwoWay}" />
            <ItemsControl ItemsSource="{Binding ViewModel.BaseSections, ElementName=Root}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="viewModels:ProcessingSection">
                    <controls:ParameterSectionControl Section="{Binding}" />
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
