<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="IceHaloStack_WinUI.Controls.EwbAdjustmentPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="7" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="6">
                <TextBlock Text="分析与平滑" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <ToggleSwitch Header="去闪" IsOn="{Binding DeflickerEnabled, Mode=TwoWay}"/>
                <NumberBox Header="去闪强度 (%)" Minimum="0" Maximum="100" Value="{Binding DeflickerStrength, Mode=TwoWay}"/>
                <NumberBox Header="去闪半径" Minimum="1" Maximum="30" Value="{Binding DeflickerRadius, Mode=TwoWay}"/>
                <ToggleSwitch Header="曝光平滑" IsOn="{Binding ExposureSmoothingEnabled, Mode=TwoWay}"/>
                <NumberBox Header="曝光强度 (%)" Minimum="0" Maximum="100" Value="{Binding ExposureStrength, Mode=TwoWay}"/>
                <NumberBox Header="曝光半径" Minimum="1" Maximum="200" Value="{Binding ExposureRadius, Mode=TwoWay}"/>
                <NumberBox Header="最大曝光修正 (EV)" Minimum="0" Maximum="5" SmallChange="0.05" Value="{Binding ExposureMaxEv, Mode=TwoWay}"/>
                <ToggleSwitch Header="白平衡平滑" IsOn="{Binding WhiteBalanceSmoothingEnabled, Mode=TwoWay}"/>
                <NumberBox Header="白平衡强度 (%)" Minimum="0" Maximum="100" Value="{Binding WhiteBalanceStrength, Mode=TwoWay}"/>
                <NumberBox Header="白平衡半径" Minimum="1" Maximum="200" Value="{Binding WhiteBalanceRadius, Mode=TwoWay}"/>
                <NumberBox Header="最大白平衡修正 (%)" Minimum="0" Maximum="100" Value="{Binding WhiteBalanceMaxPercent, Mode=TwoWay}"/>
                <NumberBox Header="整体平滑量 (%)" Minimum="0" Maximum="100" Value="{Binding SmoothingAmount, Mode=TwoWay}"/>
                <NumberBox Header="关键帧影响 (%)" Minimum="0" Maximum="100" Value="{Binding AnchorInfluence, Mode=TwoWay}"/>
                <ToggleSwitch Header="多轮平滑" IsOn="{Binding MultiPassEnabled, Mode=TwoWay}"/>
                <NumberBox Header="平滑轮数" Minimum="1" Maximum="10" Value="{Binding SmoothingPasses, Mode=TwoWay}"/>
                <ComboBox Header="分析区域" ItemsSource="{Binding AnalysisRegions}" SelectedItem="{Binding AnalysisRegion, Mode=TwoWay}"/>
                <Grid ColumnSpacing="5">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <NumberBox Header="ROI X (%)" Minimum="0" Maximum="99" Value="{Binding RoiX, Mode=TwoWay}"/>
                    <NumberBox Grid.Column="1" Header="ROI Y (%)" Minimum="0" Maximum="99" Value="{Binding RoiY, Mode=TwoWay}"/>
                </Grid>
                <Grid ColumnSpacing="5">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <NumberBox Header="ROI 宽度 (%)" Minimum="1" Maximum="100" Value="{Binding RoiWidth, Mode=TwoWay}"/>
                    <NumberBox Grid.Column="1" Header="ROI 高度 (%)" Minimum="1" Maximum="100" Value="{Binding RoiHeight, Mode=TwoWay}"/>
                </Grid>
                <TextBlock Text="当前关键帧调整" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0"/>
                <NumberBox Header="曝光 (EV)" Minimum="-5" Maximum="5" SmallChange="0.05" Value="{Binding SelectedFrame.ExposureCorrection, Mode=TwoWay}"/>
                <NumberBox Header="色温" Minimum="-100" Maximum="100" Value="{Binding SelectedFrame.TemperatureCorrection, Mode=TwoWay}"/>
                <NumberBox Header="色调" Minimum="-100" Maximum="100" Value="{Binding SelectedFrame.TintCorrection, Mode=TwoWay}"/>
                <NumberBox Header="对比度" Minimum="-100" Maximum="100" Value="{Binding SelectedFrame.Contrast, Mode=TwoWay}"/>
                <NumberBox Header="高光" Minimum="-100" Maximum="100" Value="{Binding SelectedFrame.Highlights, Mode=TwoWay}"/>
                <NumberBox Header="阴影" Minimum="-100" Maximum="100" Value="{Binding SelectedFrame.Shadows, Mode=TwoWay}"/>
                <NumberBox Header="白色" Minimum="-100" Maximum="100" Value="{Binding SelectedFrame.Whites, Mode=TwoWay}"/>
                <NumberBox Header="黑色" Minimum="-100" Maximum="100" Value="{Binding SelectedFrame.Blacks, Mode=TwoWay}"/>
                <Button Content="应用关键帧并重建全部过渡" Command="{Binding RebuildCommand}" Style="{StaticResource AccentButtonStyle}"/>
                <Button Content="再次平滑当前过渡" Command="{Binding ResmoothCommand}"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
