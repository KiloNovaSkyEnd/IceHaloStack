<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="IceHaloStack_WinUI.Controls.NodeStageEditorControl" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:IceHaloStack_WinUI.Controls">
    <StackPanel Spacing="8" MinWidth="430">
        <ToggleSwitch x:Name="EnabledSwitch" Header="启用此节点" Toggled="Enabled_Toggled" />
        <controls:ParameterSectionControl x:Name="Parameters" />
        <ComboBox x:Name="ModeBox" Visibility="Collapsed" SelectionChanged="Mode_SelectionChanged" />
        <ComboBox x:Name="SecondaryModeBox" Visibility="Collapsed" SelectionChanged="SecondaryMode_SelectionChanged" />
    </StackPanel>
</UserControl>
