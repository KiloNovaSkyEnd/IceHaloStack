<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="IceHaloStack_WinUI.Controls.ClassicCommandStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="0">
        <MenuBar x:Name="ClassicMenu" Padding="4,0">
            <MenuBarItem Title="文件">
                <MenuFlyoutItem Text="添加图像…" Click="AddImages_Click" />
                <MenuFlyoutItem Text="添加文件夹…" Click="AddFolder_Click" />
                <MenuFlyoutItem Text="打开单张 TIFF / 图片进入编辑…" Click="OpenImage_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="保存当前预览…" Click="SavePreview_Click" />
                <MenuFlyoutItem Text="选择输出目录…" Click="ChooseOutput_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="清空工程" Click="ClearProject_Click" />
                <MenuFlyoutItem Text="退出" Click="Exit_Click" />
            </MenuBarItem>
            <MenuBarItem Title="编辑">
                <MenuFlyoutItem Text="撤销" Click="Undo_Click" />
                <MenuFlyoutItem Text="重做" Click="Redo_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="全选帧" Click="SelectAll_Click" />
                <MenuFlyoutItem Text="移除所选帧" Click="RemoveSelected_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="复位全部处理参数" Click="ResetProcessing_Click" />
            </MenuBarItem>
            <MenuBarItem Title="堆栈">
                <MenuFlyoutItem Text="开始堆栈" Click="Start_Click" />
                <MenuFlyoutItem Text="暂停 / 继续" Click="Pause_Click" />
                <MenuFlyoutItem Text="使用当前结果并停止" Click="UseCurrent_Click" />
                <MenuFlyoutItem Text="取消当前任务" Click="Cancel_Click" />
            </MenuBarItem>
            <MenuBarItem Title="堆栈延时">
                <MenuFlyoutItem Text="节点工作流…" Click="OpenTimelapse_Click" />
            </MenuBarItem>
            <MenuBarItem Title="线性处理">
                <MenuFlyoutItem Text="Auto Stretch 预览（不修改数据）" Click="AutoStretch_Click"/>
                <MenuFlyoutItem Text="Asinh 拉伸 → 非线性…" Tag="stretch" Click="ProcessingSection_Click"/>
            </MenuBarItem>
            <MenuBarItem Title="调整">
                <MenuFlyoutItem Text="基础调整 / Camera Raw 风格" Tag="basic" Click="ProcessingSection_Click"/>
                <MenuFlyoutItem Text="通道混合器" Tag="channel" Click="ProcessingSection_Click"/>
            </MenuBarItem>
            <MenuBarItem Title="滤镜">
                <MenuFlyoutItem Text="USM 锐化 / 高反差保留 / 浮雕" Tag="detail" Click="ProcessingSection_Click"/>
                <MenuFlyoutItem Text="曲线 / 对比度" Tag="curves" Click="ProcessingSection_Click"/>
            </MenuBarItem>
            <MenuBarItem Title="视图">
                <MenuFlyoutItem Text="Auto Stretch 预览" Click="AutoStretch_Click"/>
                <MenuFlyoutItem Text="适合窗口" Click="FitPreview_Click"/>
            </MenuBarItem>
            <MenuBarItem Title="设置">
                <MenuFlyoutSubItem Text="界面主题">
                    <MenuFlyoutItem Text="跟随系统" Tag="Default" Click="Theme_Click"/>
                    <MenuFlyoutItem Text="浅色" Tag="Light" Click="Theme_Click"/>
                    <MenuFlyoutItem Text="深色" Tag="Dark" Click="Theme_Click"/>
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem Text="界面字体">
                    <MenuFlyoutItem Text="等线" Tag="DengXian" Click="Font_Click"/>
                    <MenuFlyoutItem Text="微软雅黑 UI" Tag="Microsoft YaHei UI" Click="Font_Click"/>
                    <MenuFlyoutItem Text="微软雅黑" Tag="Microsoft YaHei" Click="Font_Click"/>
                    <MenuFlyoutItem Text="系统默认" Tag="System" Click="Font_Click"/>
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem Text="界面语言">
                    <MenuFlyoutItem Text="中文" Tag="zh-CN" Click="Language_Click"/>
                    <MenuFlyoutItem Text="English" Tag="en" Click="Language_Click"/>
                </MenuFlyoutSubItem>
            </MenuBarItem>
            <MenuBarItem Title="帮助">
                <MenuFlyoutItem Text="单独堆栈与性能说明…" Tag="performance" Click="Help_Click"/>
                <MenuFlyoutItem Text="存储与缓存管理…" Tag="storage" Click="Help_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="关于 IceHaloStack" Tag="about" Click="Help_Click"/>
            </MenuBarItem>
        </MenuBar>

        <CommandBar x:Name="ClassicToolbar" DefaultLabelPosition="Right" IsOpen="False" OverflowButtonVisibility="Collapsed">
            <AppBarButton Icon="Add" Label="添加图像" Click="AddImages_Click" />
            <AppBarButton Icon="Folder" Label="添加文件夹" Click="AddFolder_Click" />
            <AppBarButton Icon="Delete" Label="移除" Click="RemoveSelected_Click" />
            <AppBarSeparator />
            <AppBarButton Icon="Play" Label="开始堆栈" Click="Start_Click" />
            <AppBarButton Icon="Pause" Label="暂停/继续" Click="Pause_Click" />
            <AppBarButton Icon="Stop" Label="使用当前" Click="UseCurrent_Click" />
            <AppBarButton Icon="Cancel" Label="取消" Click="Cancel_Click" />
            <AppBarButton Icon="View" Label="Auto Stretch" Click="AutoStretch_Click" />
            <AppBarButton Icon="Undo" Label="撤销" Click="Undo_Click" />
            <AppBarButton Icon="Redo" Label="重做" Click="Redo_Click" />
            <AppBarSeparator />
            <AppBarButton Icon="Video" Label="堆栈延时" Click="OpenTimelapse_Click" />
            <AppBarButton Icon="Save" Label="输出目录" Click="ChooseOutput_Click" />
        </CommandBar>
    </StackPanel>
</UserControl>
