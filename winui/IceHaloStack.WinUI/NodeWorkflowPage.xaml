<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IceHaloStack_WinUI.NodeWorkflowPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IceHaloStack_WinUI.Controls"
    xmlns:viewModels="using:IceHaloStack_WinUI.ViewModels"
    NavigationCacheMode="Required">

    <Grid Padding="8" RowSpacing="7">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Content="← 返回" Click="Back_Click" Margin="0,0,8,0" IsEnabled="{x:Bind ViewModel.CanNavigate, Mode=OneWay}" />
            <TextBlock Grid.Column="1" Text="堆栈延时 · 节点工作流 / Stack Timelapse · Node Workflow"
                       Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="输入" Opacity="0.65"/><TextBlock Text="{x:Bind ViewModel.Queue.InputCount, Mode=OneWay}"/><TextBlock Text="帧" Opacity="0.65"/>
            </StackPanel>
        </Grid>
        <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error"
                 IsClosable="False" Message="{x:Bind ViewModel.Error, Mode=OneWay}" />

        <Grid Grid.Row="2" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="285"/>
                <ColumnDefinition Width="1.38*" MinWidth="470"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="8" Padding="0,0,6,0">
                    <Expander Header="参考堆栈" IsExpanded="True">
                        <StackPanel Spacing="6" Padding="7">
                            <Button Content="添加图像…" Click="PickInputs_Click" HorizontalAlignment="Stretch"/>
                            <ComboBox Header="模式" ItemsSource="{x:Bind ViewModel.Queue.GroupingModes}"
                                      DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                      SelectedValue="{x:Bind ViewModel.Queue.GroupingMode, Mode=TwoWay}"/>
                            <ComboBox Header="堆栈方式" ItemsSource="{x:Bind ViewModel.StackMethods}"
                                      SelectedItem="{x:Bind ViewModel.Queue.StackMethod, Mode=TwoWay}"/>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <NumberBox x:Name="WindowSizeBox" Header="窗口大小" Minimum="1" Value="1"/>
                                <NumberBox x:Name="StepBox" Grid.Column="1" Header="步长" Minimum="1" Value="1"/>
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.Queue.GroupCount, Mode=OneWay}" Opacity="0.65"/>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <NumberBox x:Name="ReferenceIndexBox" Header="参考输出帧" Minimum="1" Value="1"/>
                                <Button Grid.Column="1" Content="生成参考堆栈" VerticalAlignment="Bottom"
                                        Style="{StaticResource AccentButtonStyle}" Click="GenerateReference_Click"/>
                            </Grid>
                            <Button Content="重新生成时间分组" Click="GenerateGroups_Click"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="去闪 / 曝光 / 白平衡">
                        <StackPanel Spacing="5" Padding="7">
                            <ToggleSwitch Header="去闪" IsOn="{x:Bind ViewModel.Ewb.DeflickerEnabled, Mode=TwoWay}"/>
                            <ToggleSwitch Header="曝光平滑" IsOn="{x:Bind ViewModel.Ewb.ExposureSmoothingEnabled, Mode=TwoWay}"/>
                            <ToggleSwitch Header="白平衡平滑" IsOn="{x:Bind ViewModel.Ewb.WhiteBalanceSmoothingEnabled, Mode=TwoWay}"/>
                            <Button Content="打开曝光与白平衡工作区…" Click="OpenEwb_Click"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="性能与内存 / Performance &amp; Memory">
                        <StackPanel Spacing="5" Padding="7">
                            <ComboBox Header="计算后端" ItemsSource="{x:Bind ViewModel.Queue.Compute.Options}"
                                      DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                      SelectedValue="{x:Bind ViewModel.Queue.Compute.SelectedBackend, Mode=TwoWay}"/>
                            <Button Content="重新自检 GPU" Command="{x:Bind ViewModel.Queue.RefreshComputeCommand}"/>
                            <TextBlock Text="{x:Bind ViewModel.Queue.Compute.Status, Mode=OneWay}" TextWrapping="Wrap" FontSize="11" Opacity="0.65"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="节点流程 / Flows" IsExpanded="True">
                        <StackPanel Spacing="6" Padding="7">
                            <ListView Height="150" ItemsSource="{x:Bind ViewModel.Flows}" SelectedItem="{x:Bind ViewModel.SelectedFlow, Mode=TwoWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:NodeFlowViewModel">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{x:Bind IsEnabled, Mode=TwoWay}"/>
                                            <TextBox Grid.Column="1" Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Content="＋ 新建" Command="{x:Bind ViewModel.AddFlowCommand}"/>
                                <Button Grid.Column="1" Content="复制" Command="{x:Bind ViewModel.DuplicateFlowCommand}"/>
                                <Button Grid.Column="2" Content="删除" Command="{x:Bind ViewModel.RemoveFlowCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Expander Header="批量导出 / Batch Export" IsExpanded="True">
                        <StackPanel Spacing="6" Padding="7">
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{x:Bind ViewModel.OutputDirectory, Mode=TwoWay}"/>
                                <Button Grid.Column="1" Content="选择" Click="PickOutput_Click"/>
                            </Grid>
                            <Button Content="开始批量导出所有启用流程" Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.StartExportCommand}"/>
                            <TextBlock Text="{x:Bind ViewModel.ExportBlockReason, Mode=OneWay}"
                                       TextWrapping="Wrap" FontSize="11" Opacity="0.65" />
                            <Button Content="取消" Command="{x:Bind ViewModel.CancelCommand}"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Padding="5" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="当前流程节点画布 / Node Canvas · 单击节点编辑参数" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  ZoomMode="Enabled" MinZoomFactor="0.5" MaxZoomFactor="2.5">
                        <controls:NodeGraphControl x:Name="NodeGraph" Nodes="{x:Bind ViewModel.SelectedFlow.Nodes, Mode=OneWay}"/>
                    </ScrollViewer>
                    <Button Grid.Row="2" Content="节点画布操作…" HorizontalAlignment="Right" Click="NodeHelp_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Column="2" RowSpacing="7" Padding="6,0,0,0">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Padding="5" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid RowSpacing="5">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="当前流程实时预览 / Live Preview" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                <Button Content="25%" Tag="0.25" Click="PreviewZoom_Click"/><Button Content="50%" Tag="0.5" Click="PreviewZoom_Click"/>
                                <Button Content="100%" Tag="1" Click="PreviewZoom_Click"/><Button Content="200%" Tag="2" Click="PreviewZoom_Click"/>
                                <Button Content="Fit" Click="PreviewFit_Click"/>
                            </StackPanel>
                        </Grid>
                        <ScrollViewer x:Name="PreviewScroller" Grid.Row="1" ZoomMode="Enabled" MinZoomFactor="0.1" MaxZoomFactor="4"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#101010">
                            <Image Source="{x:Bind ViewModel.PreviewSource, Mode=OneWay}" Stretch="Uniform"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Spacing="3">
                    <TextBlock Text="Processing / 处理" Opacity="0.65"/><ProgressBar Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Maximum="100"/>
                    <TextBlock Text="Writing / 写入" Opacity="0.65"/><ProgressBar Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Maximum="100"/>
                    <TextBlock Text="{x:Bind ViewModel.Phase, Mode=OneWay}" Opacity="0.65"/>
                    <ProgressBar Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Maximum="100"/>
                    <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
