<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IceHaloStack_WinUI.TimelapsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:IceHaloStack_WinUI.Controls"
    xmlns:local="using:IceHaloStack_WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:IceHaloStack_WinUI.ViewModels"
    Loaded="TimelapsePage_Loaded"
    Unloaded="TimelapsePage_Unloaded"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid Padding="32" RowSpacing="18" MaxWidth="1400" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="← 返回处理页"
                        VerticalAlignment="Top"
                        IsEnabled="{x:Bind ViewModel.Workspace.CanNavigate, Mode=OneWay}"
                        Click="Back_Click" />
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.Title}" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.Subtitle}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Spacing="8">
                <InfoBar IsOpen="True"
                         IsClosable="False"
                         Severity="Informational"
                         Message="{x:Bind ViewModel.ScopeNote}" />
                <InfoBar IsOpen="{x:Bind ViewModel.Workspace.HasError, Mode=OneWay}"
                         IsClosable="False"
                         Severity="Error"
                         Message="{x:Bind ViewModel.Workspace.Error, Mode=OneWay}" />
            </StackPanel>

            <Grid Grid.Row="2" ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>

                <Border Padding="20"
                        CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock Text="时间顺序输入队列" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="按实际拍摄时间调整顺序。分组会持续引用同一张文件，重排不会堆错图。"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid Grid.Row="1" ColumnSpacing="8" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="添加图像…"
                                    Style="{StaticResource AccentButtonStyle}"
                                    IsEnabled="{x:Bind ViewModel.Workspace.CanEdit, Mode=OneWay}"
                                    Click="PickInputs_Click" />
                            <Button Grid.Column="1"
                                    Content="移除所选"
                                    IsEnabled="{x:Bind ViewModel.Workspace.CanRemoveSelectedInput, Mode=OneWay}"
                                    Click="RemoveSelectedInput_Click" />
                            <Button Grid.Row="1"
                                    Content="上移"
                                    IsEnabled="{x:Bind ViewModel.Workspace.CanMoveInputUp, Mode=OneWay}"
                                    Click="MoveInputUp_Click" />
                            <Button Grid.Row="1"
                                    Grid.Column="1"
                                    Content="下移"
                                    IsEnabled="{x:Bind ViewModel.Workspace.CanMoveInputDown, Mode=OneWay}"
                                    Click="MoveInputDown_Click" />
                        </Grid>

                        <ListView Grid.Row="2"
                                  ItemsSource="{x:Bind ViewModel.Workspace.Inputs, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.Workspace.SelectedInput, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  IsEnabled="{x:Bind ViewModel.Workspace.CanEdit, Mode=OneWay}"
                                  MinHeight="220">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:StackInputItem">
                                    <Grid Padding="4" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Index, Mode=OneWay}"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.7" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind FileName}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Path}"
                                                       FontSize="12"
                                                       Opacity="0.65"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Padding="20"
                        CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock Text="序列分组与输出" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="每个完整分组都会输出一个 TIFF Master；滑动与中心窗口允许重叠。"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid Grid.Row="1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Header="堆栈方式"
                                      IsEnabled="{x:Bind ViewModel.Workspace.CanEdit, Mode=OneWay}"
                                      SelectedValue="{x:Bind ViewModel.Workspace.StackMethod, Mode=TwoWay}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="平均值（mean）" Tag="mean" />
                                <ComboBoxItem Content="最大值（maximum）" Tag="maximum" />
                            </ComboBox>
                            <ComboBox Grid.Column="1"
                                      Header="时间分组预设"
                                      ItemsSource="{x:Bind ViewModel.Workspace.GroupingModes, Mode=OneWay}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Value"
                                      SelectedValue="{x:Bind ViewModel.Workspace.GroupingMode, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.Workspace.CanEdit, Mode=OneWay}" />
                        </Grid>

                        <StackPanel Grid.Row="2" Spacing="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <NumberBox x:Name="GroupingWindowSizeBox"
                                           Header="窗口大小（张）"
                                           Minimum="1"
                                           Maximum="100000"
                                           SmallChange="1"
                                           SpinButtonPlacementMode="Compact"
                                           IsEnabled="{x:Bind ViewModel.Workspace.CanEdit, Mode=OneWay}"
                                           ValueChanged="GroupingWindowSizeBox_ValueChanged" />
                                <NumberBox x:Name="GroupingStepBox"
                                           Grid.Column="1"
                                           Header="滑动/中心步长（张）"
                                           Minimum="1"
                                           Maximum="100000"
                                           SmallChange="1"
                                           SpinButtonPlacementMode="Compact"
                                           IsEnabled="{x:Bind ViewModel.Workspace.CanEdit, Mode=OneWay}"
                                           ValueChanged="GroupingStepBox_ValueChanged" />
                                <Button Grid.Column="2"
                                        Content="生成序列"
                                        VerticalAlignment="Bottom"
                                        IsEnabled="{x:Bind ViewModel.Workspace.CanEdit, Mode=OneWay}"
                                        Click="GenerateGroups_Click" />
                            </Grid>
                            <TextBlock Text="固定窗口为不重叠的完整窗口；中心窗口与滑动窗口使用相同成员，但输出名称按窗口中点对齐。"
                                       FontSize="12"
                                       Opacity="0.7"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Spacing="8">
                            <TextBlock Text="批量 TIFF 输出" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Header="输出目录"
                                         PlaceholderText="选择序列 TIFF 保存目录"
                                         IsEnabled="{x:Bind ViewModel.Workspace.CanEdit, Mode=OneWay}"
                                         Text="{x:Bind ViewModel.Workspace.OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1"
                                        Content="选择目录…"
                                        VerticalAlignment="Bottom"
                                        IsEnabled="{x:Bind ViewModel.Workspace.CanEdit, Mode=OneWay}"
                                        Click="PickOutputDirectory_Click" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Header="文件命名规则"
                                         PlaceholderText="例如 timelapse_{center:000.##}"
                                         IsEnabled="{x:Bind ViewModel.Workspace.CanEdit, Mode=OneWay}"
                                         Text="{x:Bind ViewModel.Workspace.OutputFileNamePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1"
                                        Content="应用到序列"
                                        VerticalAlignment="Bottom"
                                        IsEnabled="{x:Bind ViewModel.Workspace.CanEdit, Mode=OneWay}"
                                        Click="ApplyOutputNaming_Click" />
                            </Grid>
                            <TextBlock Text="可用标记：{group}、{start}、{end}、{center}、{count}、{method}、{window}；自动追加 .tif。"
                                       FontSize="12"
                                       Opacity="0.7"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.Workspace.OutputPathPreview, Mode=OneWay}"
                                       FontSize="12"
                                       Opacity="0.7"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <ListView Grid.Row="4"
                                  ItemsSource="{x:Bind ViewModel.Workspace.Groups, Mode=OneWay}"
                                  SelectionMode="None"
                                  IsEnabled="{x:Bind ViewModel.Workspace.CanEdit, Mode=OneWay}"
                                  MinHeight="220">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:StackGroupItem">
                                    <Border Padding="12"
                                            Margin="0,0,0,8"
                                            CornerRadius="8"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                                                <Run Text="序列帧 " />
                                                <Run Text="{x:Bind GroupNumber, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{x:Bind FrameSummary, Mode=OneWay}"
                                                       TextWrapping="Wrap"
                                                       Opacity="0.75" />
                                            <TextBox Header="TIFF 输出"
                                                     IsReadOnly="True"
                                                     PlaceholderText="先选择目录并应用命名规则"
                                                     Text="{x:Bind OutputPath, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Padding="20"
                        CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="14">
                        <TextBlock Text="序列导出状态" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Workspace.Status, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{x:Bind ViewModel.Workspace.ProgressPercent, Mode=OneWay}" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="阶段" Opacity="0.7" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.Workspace.Phase, Mode=OneWay}"
                                       TextWrapping="Wrap" />
                        </Grid>
                        <Expander x:Name="ProcessingExpander" Header="处理方案" IsExpanded="False">
                            <ScrollViewer x:Name="DeferredProcessingPanel"
                                          x:Load="{x:Bind ProcessingExpander.IsExpanded, Mode=OneWay}"
                                          MaxHeight="620">
                                <controls:ProcessingSettingsControl ViewModel="{x:Bind ViewModel.Workspace.Processing, Mode=OneWay}" />
                            </ScrollViewer>
                        </Expander>
                        <Expander x:Name="VideoExportExpander" Header="视频导出" IsExpanded="False">
                            <StackPanel x:Name="DeferredVideoExportPanel"
                                        x:Load="{x:Bind VideoExportExpander.IsExpanded, Mode=OneWay}"
                                        Spacing="8">
                                <ToggleSwitch Header="同时生成视频"
                                              IsOn="{x:Bind ViewModel.Workspace.Video.Enabled, Mode=TwoWay}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Header="视频输出" IsReadOnly="True"
                                             Text="{x:Bind ViewModel.Workspace.Video.OutputPath, Mode=OneWay}" />
                                    <Button Grid.Column="1" Content="另存为…" VerticalAlignment="Bottom"
                                            Click="PickVideoOutput_Click" />
                                </Grid>
                                <ComboBox Header="格式" ItemsSource="{x:Bind ViewModel.Workspace.Video.Formats}"
                                          SelectedItem="{x:Bind ViewModel.Workspace.Video.Format, Mode=TwoWay}" />
                                <NumberBox Header="帧率" Minimum="0.1" Maximum="240" SmallChange="1"
                                           Value="{x:Bind ViewModel.Workspace.Video.FramesPerSecond, Mode=TwoWay}" />
                                <ComboBox Header="分辨率" ItemsSource="{x:Bind ViewModel.Workspace.Video.Resolutions}"
                                          SelectedItem="{x:Bind ViewModel.Workspace.Video.Resolution, Mode=TwoWay}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox Header="自定义宽度" Minimum="2" Maximum="16384" SmallChange="2"
                                               Value="{x:Bind ViewModel.Workspace.Video.CustomWidth, Mode=TwoWay}" />
                                    <NumberBox Grid.Column="1" Header="自定义高度" Minimum="2" Maximum="16384" SmallChange="2"
                                               Value="{x:Bind ViewModel.Workspace.Video.CustomHeight, Mode=TwoWay}" />
                                </Grid>
                                <ComboBox Header="适配方式" ItemsSource="{x:Bind ViewModel.Workspace.Video.FitModes}"
                                          SelectedItem="{x:Bind ViewModel.Workspace.Video.FitMode, Mode=TwoWay}" />
                            </StackPanel>
                        </Expander>
                        <StackPanel Spacing="8" Margin="0,12,0,0">
                            <Button Content="开始导出 TIFF 序列"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.Workspace.StartStackCommand}" />
                            <Button Content="取消"
                                    IsEnabled="{x:Bind ViewModel.Workspace.CanCancel, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.Workspace.CancelCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
    </Grid>
</Page>
